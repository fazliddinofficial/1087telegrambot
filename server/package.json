{
  "name": "taxi-balans-server",
  "version": "0.1.0",
  "private": true,
  "description": "Taksi haydovchilari balansini to'ldirish: Telegram bot va API",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev:db": "tsx scripts/devDb.ts",
    "dev:init-data": "tsx scripts/devInitData.ts",
    "dev:seed": "tsx scripts/devSeed.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "telegraf": "^4.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
