# @BotFather bergan token va bot nomi
BOT_TOKEN=
BOT_USERNAME=

# Super admin(lar)ning Telegram'dagi telefon raqami, vergul bilan. Botga /admin yozib tasdiqlanadi.
SUPER_ADMIN_PHONES=
# Ixtiyoriy: telefon o'rniga Telegram ID (@userinfobot ko'rsatadi), vergul bilan.
# SUPER_ADMIN_IDS=

# Mini App manzili. Telegram faqat https qabul qiladi.
WEBAPP_URL=https://example.com

# Lokal ishga tushirish uchun. Docker'da compose o'zi almashtiradi.
MONGO_URI=mongodb://127.0.0.1:27027/taxi_balans
PORT=4020

# Faqat docker compose uchun. Parolda faqat harf va raqam ishlating.
MONGO_USER=taxi
MONGO_PASSWORD=

# Ixtiyoriy (qiymatlar standart holatda shunday)
# BOT_POLLING=true
# MIN_AMOUNT=1000
# MAX_AMOUNT=20000000
# MAX_OPEN_PAYMENTS=3
# INVITE_TTL_HOURS=24
# REMIND_NEW_MINUTES=10
# REMIND_IN_PROGRESS_MINUTES=30
